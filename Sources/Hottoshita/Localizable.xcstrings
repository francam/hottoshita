    "erase.footer" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes your name, trusted contacts, settings and every check-in from this device and from iCloud. Hottoshita starts again as if newly installed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お名前・連絡先・設定とすべてのチェックインを、この端末と iCloud から削除します。アプリは初めて開いたときの状態に戻ります。"
          }
        }
      }
    },
    "erase.message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your name, your trusted contacts, your settings and all your check-ins will be deleted from this device and from iCloud. Other devices keep their own copy until you erase them there too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お名前、見守る方の連絡先、設定、すべてのチェックインが、この端末と iCloud から削除されます。ほかの端末にあるデータは、その端末でも消去するまで残ります。"
          }
        }
      }
